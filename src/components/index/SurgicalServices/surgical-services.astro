---
import styles from "./surgical-services.module.css";
import services from "./surgical-services";

const { class: className } = Astro.props;
---

<section class={`${className} ${styles.section}`}>
	<div>
		<div class={`${styles.text_content}`}>
			<div class={styles.headingWrapper}>
				<span class={styles.text_content_subtitle}>Our Services</span>
				<h2 class={styles.text_content__header}>Surgical Services</h2>
			</div>
			<p class={styles.text_content__summary}>
				Explore our range of advanced surgical treatments for a variety
				of eye conditions and diseases. We combine modern technology
				with personalized care to achieve the best possible outcomes.
				From consultation to recovery, Dr. Roberts and her dedicated
				team are committed to providing high-quality care focused on
				your comfort, safety, and long-term vision health.
			</p>
		</div>
		<div class={styles.masonry}>
			{
				services.map((element) => (
					<div class={`${styles.card}`}>
						<div class={styles.card__image_wrapper}>
							<img
								src={element.image}
								alt={`Image of ${element.title} procedure`}
								class={styles.card__image}
							/>
						</div>

						<div class={styles.card__content}>
							<div class={styles.card__header}>
								<h3 class={styles.card__title}>
									{element.title}
								</h3>
								<small class={styles.card__kicker}>
									{element.kicker}
								</small>
							</div>
							<p class={styles.card__description}>
								{element.description}
							</p>
							<button class={styles.card__button}>
								Learn More
								<svg
									xmlns="http://www.w3.org/2000/svg"
									width="20"
									height="20"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									class={styles.card__button_arrow}
								>
									<line x1="7" y1="17" x2="17" y2="7" />
									<polyline points="7 7 17 7 17 17" />
								</svg>
							</button>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
