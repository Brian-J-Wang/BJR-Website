---
import styles from "./Hero.module.css";

const { class: className = "" } = Astro.props;
---

<div class={`${className} ${styles.wrapper}`}>
	<section class={styles.hero} id="thresholdElement">
		<div class={styles.heroContent}>
			<div class={styles.welcome}>
				<span>Welcome to</span>
				<strong>BJR OPHTHALMOLOGY</strong>
				<p class={styles.statement}>
					Expert Eye Care for a Clearer Future
				</p>
			</div>
			<button
				class={`${styles.appointmentButton} containerUnderlineOnHover`}
			>
				<span>Book a Consultation</span>
				<svg
					width="14"
					height="14"
					viewBox="0 0 12 12"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M6 11L10.6464 6.35355C10.8417 6.15829 10.8417 5.84171 10.6464 5.64645L6 1"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"></path>
					<path
						d="M1 6H10"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</section>
	<div class={styles.statistics}>
		<div class={styles.statCard}>
			<span class={styles.statValue}>2</span>
			<span class={styles.statLabel}>Locations</span>
		</div>
		<div class={styles.statCard}>
			<span class={styles.statValue}>5</span>
			<span class={styles.statLabel}>Expert Doctors</span>
		</div>
		<div class={styles.statCard}>
			<span class={styles.statValue}>2009</span>
			<span class={styles.statLabel}>Open Since</span>
		</div>
	</div>
</div>
