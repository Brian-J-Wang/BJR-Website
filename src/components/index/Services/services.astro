---
import styles from "./services.module.css";
import surgicalServices from "./surgical-services";
import eyeServices from "./eye-services";
import Tabs from "./servicesCatalogue/ServicesCatalogue";

const { class: className } = Astro.props;

const allServices = [
	{ group: "Surgical Services", items: surgicalServices },
	{ group: "Eye Services", items: eyeServices },
];
---

<section class={`${className} ${styles.section}`}>
	<div class={styles.content}>
		<div class={styles.intro}>
			<div class={styles.intro__headingWrapper}>
				<span class={styles.intro__subtitle}>Excellence & Care</span>
				<h2 class={styles.intro__title}>Our Services</h2>
			</div>
			<p class={styles.intro__summary}>
				We combine modern technology with personalized care to achieve
				the best possible outcomes for a variety of eye conditions and
				diseases. From consultation to recovery, we provide expert
				clinical care tailored to your unique visual needs.
			</p>
		</div>

		<Tabs client:load allServices={allServices} />
	</div>
</section>
