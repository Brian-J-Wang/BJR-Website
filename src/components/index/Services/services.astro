---
import shared from "@styles/shared.module.css";
import styles from "./services.module.css";
import { surgicalServices, eyeServices } from "./services";
import Tabs from "./servicesCatalogue/ServicesCatalogue";
import clsx from "clsx";

const { class: className } = Astro.props;

const allServices = [
	{ group: "Surgical Services", items: surgicalServices },
	{ group: "Eye Services", items: eyeServices },
];
---

<section class={`${styles.section}`}>
	<div class={styles.content}>
		<div class={styles.intro}>
			<div class={styles.intro__headingWrapper}>
				<h2 class={styles.intro__title}>Our Services</h2>
			</div>
			<p data-variant="contrast">
				We combine modern technology with personalized care to achieve the best possible
				outcomes for a variety of eye conditions and diseases. From consultation to
				recovery, we provide expert clinical care tailored to your unique visual needs.
			</p>
		</div>

		<Tabs client:load allServices={allServices} />
	</div>
</section>
