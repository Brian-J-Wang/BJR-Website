---
import drRobert from "./drRobert.module.css";
---

<section class={drRobert.doctorBio}>
	<div class={drRobert.doctorBio__card}>
		<div class={drRobert.doctorBio__portraitWrapper}>
			<img
				src="/profileBJR.png"
				alt="Dr. BingJing Z. Roberts, Board-Certified Ophthalmologist"
				class={drRobert.doctorBio__portraitImage}
			/>
		</div>
		<div class={drRobert.doctorBio__content}>
			<div class={drRobert.doctorBio__header}>
				<h2 class={drRobert.doctorBio__name}>
					BingJing Z. Roberts, M.D.
				</h2>
				<span class={drRobert.doctorBio__title}>
					Board-Certified Ophthalmologist
				</span>
			</div>
			<div class={drRobert.doctorBio__body}>
				<p class={drRobert.doctorBio__paragraph}>
					Dr. BingJing Z. Roberts is a board-certified ophthalmologist
					with over 20 years of clinical experience. Dr. Roberts
					received her medical degree from the University of Maryland
					School of Medicine and completed her residency in
					ophthalmology at Montefiore Medical Center. She specializes
					in treating complex eye conditions such as cataracts,
					glaucoma, and retinal diseases, and performs advanced
					surgeries including laser retina surgery and lens
					replacement.
				</p>
				<p class={drRobert.doctorBio__paragraph}>
					She also serves on the board of directors of the Coalition
					of Asian-American Independent Practice Association (CAIPA).
				</p>
			</div>
		</div>
	</div>
</section>
