---
import Logo from "../logo/logo";
import styles from "./footer.module.css";
---

<footer class={styles.footer} role="contentinfo">
	<div class={styles.mainContent}>
		<div class={styles.sideContent}>
			<Logo
				containerStyle={styles.logo}
				titleStyle={styles.logoTitle}
				subtitleStyle={styles.logoSubtitle}
				logoStyle={styles.logoImage}
				client:load
			/>
			<p class={styles.logoBlurb}>
				Expert Doctors, Professional Staff, Satisfied Patients
			</p>
		</div>

		<div class={styles.footerContent}>
			<nav class={styles.section} aria-label="Footer - Team">
				<h3>Our Team</h3>
				<ul class={styles.content}>
					<li><a href="/about-dr-roberts">About Dr. Roberts</a></li>
					<li><a href="/doctors">Our Doctors</a></li>
					<li><a href="/staff">Our Staff</a></li>
				</ul>
			</nav>

			<nav class={styles.section} aria-label="Footer - Surgeries">
				<h3>Surgeries</h3>
				<ul class={styles.content}>
					<li><a href="/surgeries#lasik">LASIK</a></li>
					<li><a href="/surgeries#evo-icl">EVO ICL</a></li>
					<li><a href="/surgeries#cataracts">Cataracts</a></li>
					<li><a href="/surgeries#toric">Toric IOL</a></li>
					<li><a href="/surgeries#multifocal">Multifocal IOL</a></li>
					<li>
						<a href="/surgeries#multifocal-toric"
							>Multifocal Toric</a
						>
					</li>
				</ul>
			</nav>

            <nav>
                
            </nav>

			<nav class={styles.section} aria-label="Footer - Resources">
				<h3>Patient Resources</h3>
				<ul class={styles.content}>
					<li><a href="/insurance">Accepted Insurances</a></li>
					<li><a href="/careers">Careers</a></li>
				</ul>
			</nav>

			<div class={styles.divider}></div>

			<section class={styles.section} aria-label="Our Locations">
				<h3 class={styles.title}>Locations</h3>
				<div class={styles.content}>
					<address
						class={styles.location}
						itemscope
						itemtype="https://schema.org/MedicalBusiness"
					>
						<h4 itemprop="name">Manhattan</h4>
						<div
							itemprop="address"
							itemscope
							itemtype="https://schema.org/PostalAddress"
						>
							<p itemprop="streetAddress">185 Canal St, #306</p>
							<p>
								<span itemprop="addressLocality">Manhattan</span
								>,
								<span itemprop="addressRegion">NY</span>
								<span itemprop="postalCode">10013</span>
							</p>
						</div>
						<a
							href="tel:2122197786"
							itemprop="telephone"
							class={styles.phoneLink}>(212) 219-7786</a
						>
					</address>

					<address
						class={styles.location}
						itemscope
						itemtype="https://schema.org/MedicalBusiness"
					>
						<h4 itemprop="name">Brooklyn</h4>
						<div
							itemprop="address"
							itemscope
							itemtype="https://schema.org/PostalAddress"
						>
							<p itemprop="streetAddress">749 61st St, #303</p>
							<p>
								<span itemprop="addressLocality">Brooklyn</span
								>,
								<span itemprop="addressRegion">NY</span>
								<span itemprop="postalCode">11220</span>
							</p>
						</div>
						<a
							href="tel:7184923500"
							itemprop="telephone"
							class={styles.phoneLink}>(718) 492-3500</a
						>
					</address>
				</div>
			</section>
		</div>
	</div>

	<div class={styles.miscContent}>
		<div class={styles.legal}>
			<a href="/accessibility">Accessibility</a> |
			<a href="/terms">Terms of Service</a> |
			<a href="/privacy-policy">Privacy Policy</a> |
			<a href="/sitemap">Sitemap</a>
		</div>
		<div class={styles.copyright}>
			<small>
				&copy; {new Date().getFullYear()} Bingjing Roberts Ophthalmology.
				All Rights Reserved.
			</small>
			<small class={styles.attribution}>
				Designed, Developed, and Deployed by Brian Wang
			</small>
		</div>
	</div>
</footer>
