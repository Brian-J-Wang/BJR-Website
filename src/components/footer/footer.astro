---
import Logo from "../logo/logo"
import styles from "./footer.module.css"
---
<footer class={styles.footer}>
    <div class={styles.mainContent}>
        <div class={styles.sideContent}>
            <Logo containerStyle={styles.logo} titleStyle={styles.logoTitle} 
            subtitleStyle={styles.logoSubtitle} logoStyle={styles.logoImage} client:load />
            <small class={styles.logoBlurb}>
                Expert Doctors, Professional Staff, Satisfied Patients
            </small>
        </div>
        <div class={styles.footerContent}>
            <div class={styles.section}>
                <h3>Our Team</h3>
                <div class={styles.content}>
                    <a href="">About Dr. Roberts</a>
                    <a href="">Our Doctors</a>
                    <a href="">Our Staff</a>
                </div>
            </div>
            <div class={styles.section}>
                <h3>Eye Surgeries</h3>
                <div class={styles.content}>
                    <a href="">Lasik</a>
                    <a href="">EVO ICL</a>
                    <a href="">Cataracts</a>
                </div>
            </div>
            <div class={styles.section}>
                <h3>Eye Exams</h3>
                <div class={styles.content}>
                    <a href="">Why Yearly Eye Exams</a>
                    <a href="">Common Eye Diseases</a>
                    <a href="">Eye Care Resources</a>
                </div>
            </div>
            <div class={styles.section}>
                <h3>Resources</h3>
                <div class={styles.content}>
                    <a href="">Accepted Insurances</a>
                    <a href="">Careers</a>
                </div>
            </div>
            <div class={styles.divider}>
            </div>
            <div class={styles.section}>
                <h3 class={styles.title}>Locations</h3>
                <div class={styles.content}>
                    <div class={styles.location}>
                        <h4>
                            Manhatten
                        <p>185 Canal St, #306</p>
                        <p>Manhatten, NY 10013</p>
                        <p>(212) 219-7786</p>
                    </div>
                    <div class={styles.location}>
                        <h4>
                            Brooklyn
                        </h4>
                        <p>749 61st St. #303</p>
                        <p>Brooklyn, NY 11220</p>
                        <p>(718) 492-3500</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class={styles.miscContent}>
        <div class={styles.legal}>
            <a href="">Accessibility</a> |
            <a href="">Terms of Service</a> | 
            <a href="privacy-policy">Privacy Policy</a> | 
            <a href="">Sitemap</a>
        </div>
        <div>
            <small>
                Designed and Developed by Brian Wang
            </small>
        </div>
    </div>
</footer>