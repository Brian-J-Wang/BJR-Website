---
import aboutUs from "./aboutUs.module.css"
import drRobert from "./drRobert.module.css"
---
<section class={aboutUs.section}>
    <div class={aboutUs.content}>
        <div class={aboutUs.headingWrapper}>
            <span class={aboutUs.subtitle}>Our Clinic</span>
            <h2 class={aboutUs.heading}>
                About Us
            </h2>
        </div>	
        <div class={aboutUs.textContainer}>
            <p class={aboutUs.text}>
                Established in 2009, our ophthalmology clinic has proudly served tens of thousands of patients across the five boroughs. 
                We are dedicated to delivering high-quality, personalized eye care with a deep understanding of the communities we serve.
            </p>
            <p class={aboutUs.text}>
                Our multilingual team is fluent in Chinese and English, allowing us to communicate clearly and comfortably with a diverse patient base.
                While we primarily serve the Asian community, we welcome patients from all backgrounds and are committed to providing attentive,
                culturally sensitive care to everyone who walks through our doors.
            </p>
        </div>
    </div>
    <div class={drRobert.doctorBioCard}>
        <div class={drRobert.portraitWrapper}>
            <img src="/profileBJR.png" alt="Dr. BingJing Z. Roberts, Board-Certified Ophthalmologist" class={drRobert.portraitImage}>
        </div>
        <div class={drRobert.bioContent}>
            <div class={drRobert.bioHeader}>
                <h2 class={drRobert.doctorName}>
                    BingJing Z. Roberts, M.D.
                </h2>
                <span class={drRobert.doctorTitle}>Board-Certified Ophthalmologist</span>
            </div>
            <div class={drRobert.bioBody}>
                <p class={drRobert.bioParagraph}>
                    Dr. BingJing Z. Roberts is a board-certified ophthalmologist with over 20 years of clinical experience.
                    Dr. Roberts received her medical degree from the University of Maryland School of Medicine and completed
                    her residency in ophthalmology at Montefiore Medical Center. She specializes in treating complex eye conditions
                    such as cataracts, glaucoma, and retinal diseases, and performs advanced surgeries including laser retina surgery
                    and lens replacement.
                </p>
                <p class={drRobert.bioParagraph}>
                    She also serves on the board of directors of the Coalition of Asian-American Independent Practice Association (CAIPA).
                </p>
            </div>
        </div>
    </div>
</section>