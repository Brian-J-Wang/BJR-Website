---
	import styles from "../styles/index.module.css"
	import Layout from "../layouts/layout.astro"
	import ServicesCarousel from "./index.components/_servicesCarousel"
	import TestimonialCarousel from "./index.components/_testimonialsCarousel"
---
<Layout 
	title="Top Ophthalmologist in Manhattan & Brooklyn | BJR Ophthalmology"
	description="Dr. BingJing Z. Roberts is a board-certified ophthalmologist offering advanced medical and surgical eye care in Brooklyn and Lower Manhattan."
>
	<div class={styles.hero} id="thresholdElement">
		<div class={styles.heroContent}>
			<h1 class={styles.statement}>
				Proudly Serving <br> Lower Manhattan <br> and Brooklyn
			</h1>
			<small class={styles.subStatement}>
				Expert Doctors. Professional Staff. Satisfied Patients.
			</small>
			<button class={styles.appointmentButton}>
				Book a Consultation Today
			</button>
		</div>
	</div>
	<section class={styles.AboutUs}>
		<div class={styles.content}>
			<div>
				<h2>
					About Us
				</h2>
			</div>	
			<div>
				<p>
					Established in 2009, our ophthalmology clinic has proudly served tens of thousands of patients across the five boroughs. 
					We are dedicated to delivering high-quality, personalized eye care with a deep understanding of the communities we serve.
				</p>
				<p>
					Our multilingual team is fluent in Chinese and English, allowing us to communicate clearly and comfortably with a diverse patient base.
					While we primarily serve the Asian community, we welcome patients from all backgrounds and are committed to providing attentive,
					culturally sensitive care to everyone who walks through our doors.
				</p>
			</div>
		</div>
	</section>
	<section class={styles.DrRobert}>
		<img src="/profileBJR.png" alt="Dr. BingJing Z. Roberts, Board-Certified Ophthalmologist" class={styles.profile}>
		<div class={styles.content}>
			<h2>
				BingJing Z. Roberts, M.D.
			</h2>
			<div class={styles.summary}>
				<p>
					Dr. BingJing Z. Roberts is a board-certified ophthalmologist with over 20 years of clinical experience.
					Dr. Roberts received her medical degree from the University of Maryland School of Medicine and completed
					her residency in ophthalmology at Montefiore Medical Center. She specializes in treating complex eye conditions
					such as cataracts, glaucoma, and retinal diseases, and performs advanced surgeries including laser retina surgery
					and lens replacement.
				</p>
				<p>
					She also serves on the board of directors of the Coalition of Asian-American Independent Practice Association (CAIPA).
				</p>
			</div>
		</div>
	</section>
	<section class={styles["surgical-services"]}>
		<div>
			<div class={styles["content"]}>
			<h2>Surgical Services</h2>
			<p class={styles["summary"]}>
				Explore our range of advanced surgical treatments for a variety of eye conditions and diseases. 
				We combine modern technology with personalized care to achieve the best possible outcomes. 
				From consultation to recovery, Dr. Roberts and her dedicated team are committed to providing high-quality care focused 
				on your comfort, safety, and long-term vision health.
			</p>
			</div>
			<ServicesCarousel client:only="react"/>
		</div>
	</section>
	<section class={styles.officeLocations}>
		<h2>Our Locations</h2>
		<p>
			We operate in two convenient locations in Brooklyn and Manhattan. 
			No matter which office you visit, you can expect the same high standard of care from our doctors and staff.
		</p>
		<div>
			<div>
				Brooklyn
			</div>
			<div>
				Manhattan
			</div>
		</div>
	</section>
	<section class={styles.testimonial}>
		<div class={styles.testimonialHeader}>
			<h2>Patient Testimonials</h2>
			<small>
				Real results from real people.
			</small>
		</div>
		<div>
			<TestimonialCarousel client:only="react"/>
		</div>
	</section>
</Layout>
