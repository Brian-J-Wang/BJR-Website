---
import styles from "./layout.module.css"
import Header from "../components/header/header"

const currentPath = Astro.url.pathname;
console.log(currentPath)
---
<body>
    <head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>BJR Ophthalmology</title>
	</head>
    <Header client:load></Header>
    <main>
        <slot />
    </main>
    <footer class={styles.footer}>
        <div class={styles.content}>
            <div class={styles.nav}>
                <nav aria-label="Footer Navigation">
                    <ul>
                        <li>
                            <a href="">Our Team</a>
                        </li>
                        <li>
                            <a href="">Eye Surgeries</a>
                        </li>
                        <li>
                            <a href="">Eye Exams</a>
                        </li>
                        <li>
                            <a href="">Resources</a>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class={styles.locations}>
                <h3 class={styles.title}>Locations</h3>
                <div class={styles.content}>
                    <div class={styles.location}>
                        <h4>
                            Manhatten
                        <p>185 Canal St, #306</p>
                        <p>Manhatten, NY 10013</p>
                        <p>(212)-219-7786</p>
                    </div>
                    <div class={styles.location}>
                        <h4>
                            Brooklyn
                        </h4>
                        <p>749 61st St. #303</p>
                        <p>Brooklyn, NY 11220</p>
                        <p>(718)-492-3500</p>
                    </div>
                </div>
            </div>
        </div>
        <div>
            <small>
                Designed and Built By Brian Wang
            </small>
        </div>
    </footer>
</body>