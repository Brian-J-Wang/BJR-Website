---
import "./layout.css"
import Header from "../components/header/header"
import Footer from "../components/footer/footer.astro";

const { 
	title = "BJR Ophthalmology", 
	description = "Expert eye care by Dr. BingJing Z. Roberts in Lower Manhattan and Brooklyn. Specializing in cataracts, glaucoma, and retinal diseases.",
	includeHeaderBuffer = false 
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<Header includeBuffer={includeHeaderBuffer} client:load></Header>
		<main>
			<slot />
		</main>
		<Footer/>
	</body>
</html>